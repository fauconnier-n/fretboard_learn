{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "checkJs": false,
    "strict": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
